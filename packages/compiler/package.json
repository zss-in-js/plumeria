{
  "name": "@plumeria/compiler",
  "version": "19.8.0",
  "description": "Plumeria rust based compiler for statically extracting css",
  "author": "Refirst 11",
  "license": "MIT",
  "funding": "https://github.com/sponsors/refirst11",
  "homepage": "https://plumeria.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zss-in-js/plumeria.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/zss-in-js/plumeria/issues"
  },
  "main": "index.js",
  "browser": "browser.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js"
  ],
  "napi": {
    "binaryName": "compiler",
    "targets": [
      "aarch64-linux-android",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "armv7-unknown-linux-gnueabihf",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-unknown-freebsd",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc",
      "wasm32-wasip1-threads"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js index.js --dts index.d.ts",
    "packages": "node scripts/generate-platform-packages.ts",
    "readme": "node scripts/generate-platform-readme.ts",
    "update:main": "node scripts/update-main-package.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.3",
    "@napi-rs/wasm-runtime": "1.2.4",
    "@plumeria/utils": "workspace:*",
    "@swc/core": "catalog:",
    "zss-engine": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
