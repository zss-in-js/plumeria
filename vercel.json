{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/blog/eating-up-the-libraries",
      "destination": "https://refirst11.vercel.app/posts/2026-05-10",
      "permanent": true
    },
    {
      "source": "/docs/api-reference/javascript/viewTransition",
      "destination": "/docs/api-reference/javascript/viewTransitionClass",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/docs.md", "destination": "/llms.mdx/docs.md" },
    { "source": "/docs/:path*.md", "destination": "/llms.mdx/docs/:path*.md" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/playground",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/playground/:path*",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/_next/static/:path*/turbopack-worker-:name",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
